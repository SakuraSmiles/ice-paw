{
  "name": "ice-paw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ice-paw/app dev",

    "build": "pnpm -r --filter @ice-paw/ui build && pnpm --filter @ice-paw/app build",
    "build:ui": "pnpm --filter @ice-paw/ui build",
    "build:app": "pnpm --filter @ice-paw/app build",

    "tauri": "pnpm --filter @ice-paw/app tauri",
    "tauri:dev": "pnpm --filter @ice-paw/app tauri dev",
    "tauri:build": "pnpm --filter @ice-paw/app tauri build",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.63.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "pnpm": ">=9",
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0"
}
