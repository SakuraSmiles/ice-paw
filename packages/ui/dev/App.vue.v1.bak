const ddDisabledItems = [
  { type: 'item' as const, key: 'view', label: '查看', icon: Search, onClick: () => ddAction('查看') },
  { type: 'item' as const, key: 'edit-disabled', label: '编辑', icon: Pencil, disabled: true },
