{
  "name": "@ice-paw/app",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:mcp": "powershell -ExecutionPolicy Bypass -File ../../scripts/prepare-mcp-runtime.ps1",
    "prepare:pdfium": "powershell -ExecutionPolicy Bypass -File ../../scripts/prepare-pdfium.ps1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ice-paw/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
